<?xml version="1.0" encoding="utf-8"?>
<!--
  IRIS adaptive icon — foreground layer.
  Drop into res/drawable/ic_launcher_foreground.xml
  Pair with res/drawable/ic_launcher_background.xml (solid color) and the
  mipmap-anydpi-v26/ic_launcher.xml adaptive-icon wrapper included alongside this file.

  Easier alternative: in Android Studio, right-click res > New > Image Asset,
  choose "Adaptive and Legacy", and point it at iris-app-icon.png from this
  same folder — it will generate all density folders for you automatically.
  Use this hand-built version only if you want pixel-exact control.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- speech bubble -->
    <path
        android:pathData="M26.7 16.5 H74.3 a8.5 8.5 0 0 1 8.5 8.5 V47.1 a8.5 8.5 0 0 1 -8.5 8.5 H35.2 L21.6 67.5 L24.15 55.6 H26.7 a8.5 8.5 0 0 1 -8.5 -8.5 V25 a8.5 8.5 0 0 1 8.5 -8.5 Z"
        android:fillColor="#2D2B36"
        android:strokeColor="#3A3744"
        android:strokeWidth="1.2"/>

    <!-- faint small "i" peeking from the bubble (dot + stem) -->
    <path
        android:pathData="M48.9,36.4 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#F5F3F0"
        android:fillAlpha="0.4"/>
    <path
        android:pathData="M48.7,39 h2.6 a1.3,1.3 0 0 1 1.3,1.3 V46 a1.3,1.3 0 0 1 -1.3,1.3 H48.7 a1.3,1.3 0 0 1 -1.3,-1.3 V40.3 a1.3,1.3 0 0 1 1.3,-1.3 Z"
        android:fillColor="#F5F3F0"
        android:fillAlpha="0.4"/>

    <!-- magnifying glass lens (ring) -->
    <path
        android:pathData="M64.1,28.4 a17,17 0 1,0 0.001,0"
        android:fillColor="#00000000"
        android:strokeColor="#FF8A5B"
        android:strokeWidth="3.8"/>

    <!-- magnifying glass handle -->
    <path
        android:pathData="M76,57.3 L86.2,67.5"
        android:strokeColor="#FF8A5B"
        android:strokeWidth="5.1"
        android:strokeLineCap="round"/>

    <!-- magnified "i" inside the lens (dot + stem) -->
    <path
        android:pathData="M64.1,38.5 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#F5F3F0"/>
    <path
        android:pathData="M61.6,43 h5 a2.5,2.5 0 0 1 2.5,2.5 V57.5 a2.5,2.5 0 0 1 -2.5,2.5 H61.6 a2.5,2.5 0 0 1 -2.5,-2.5 V45.5 a2.5,2.5 0 0 1 2.5,-2.5 Z"
        android:fillColor="#F5F3F0"/>

</vector>
