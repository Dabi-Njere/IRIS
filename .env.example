# Copy to .env.local for local dev. In Vercel, set these under
# Project Settings > Environment Variables instead — never commit real values.

# Server-side only — holds the real Claude API key. NEXT_PUBLIC_ vars are
# exposed to the browser; this one deliberately is not.
ANTHROPIC_API_KEY=your_key_here

# Supabase project URL (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — server-side only, NEVER expose this to the browser or
# Android app. It bypasses Row Level Security entirely. This is what lets
# the backend read/write Supabase on the owner's behalf.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# A shared secret the Android app sends with every request, so randos
# can't hit your backend even if they find the URL. Generate any random
# string (e.g. `openssl rand -hex 32`).
DEVICE_SHARED_SECRET=your_random_secret_here
